# ============================================================
# CONFIGURATION LHM MADAGASCAR - Backend
# Copiez ce fichier en .env et remplissez les valeurs
# ============================================================

# Base de données PostgreSQL
# Format: postgresql://UTILISATEUR:MOT_DE_PASSE@HOTE:PORT/NOM_BASE
DATABASE_URL="postgresql://postgres:votre_mot_de_passe@localhost:5432/lhm_madagascar"

# JWT
JWT_SECRET="lhm-madagascar-secret-key-changez-en-production-2024"
JWT_EXPIRES_IN="24h"

# Serveur
PORT=5000
NODE_ENV=development

# CORS - Adresse du frontend
CORS_ORIGIN="http://localhost:3000"
